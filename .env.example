# StoneSuite Frontend Configuration

# API Configuration
VITE_API_BASE_URL=http://localhost:5000

# stonesuite-notify — separate service, same JWT (JWT_SECRET must match
# StoneSuite-Backend's). Powers the notification bell (unread count, list,
# mark-as-read).
VITE_NOTIFY_BASE_URL=http://localhost:8090

# ===================================
# Microsoft Entra ID OAuth
# ===================================
# This should match the Client ID from your Azure App Registration
VITE_ENTRA_CLIENT_ID=your-entra-id-client-id

# ===================================
# AWS Cognito OAuth
# ===================================
# This should match the Client ID from your Cognito App Client
VITE_COGNITO_CLIENT_ID=your-cognito-client-id

# This is your Cognito domain (without https://)
# Format: your-domain.auth.region.amazoncognito.com
VITE_COGNITO_DOMAIN=your-domain.auth.us-east-1.amazoncognito.com
